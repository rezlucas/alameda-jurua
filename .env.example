# Endpoint que recebe os leads (POST com corpo JSON). Ex.: webhook do Zapier/Make/RD Station/Google Apps Script.
# Se vazio, o formulário abre o WhatsApp com os dados preenchidos (nenhum lead é perdido).
NEXT_PUBLIC_LEAD_ENDPOINT=
# Google Tag Manager (opcional) — ex.: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Meta Pixel (opcional)
NEXT_PUBLIC_META_PIXEL_ID=
